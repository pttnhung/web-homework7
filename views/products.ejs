<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Danh sách sản phẩm</title>
</head>
<body>
  <h1>Danh sách sản phẩm</h1>
  <ul>
    <% products.forEach((product) => { %>
      <li>
        <a href="/products/<%= product.id %>"><%= product.name %></a>
        - $<%= product.price %>
      </li>
    <% }) %>
  </ul>
</body>
</html>
